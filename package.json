{
  "name": "ai-pioneer-geo-console",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "node --watch server/server.js",
    "start": "node server/server.js",
    "build": "vite build",
    "test": "node --test",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2",
    "wouter": "3.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.2",
    "supertest": "^7.1.4",
    "vite": "^7.1.3"
  }
}
